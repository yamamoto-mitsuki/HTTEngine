<?xml version="1.0" encoding="utf-8"?>
<!--
=============================================================================
 Sandbox.vcxproj
 エンジンの起動確認・機能テスト用の exe（エンジンはスタティックライブラリなので、動かすには exe が要る）
 ゲームと同じく HTTEngine.props を読む。エンジン・DirectXTex・ImGui の参照とライブラリは props が全部決める
=============================================================================
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ===== 構成（エンジンと同じ3つ） ===== -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Development|x64">
      <Configuration>Development</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- ===== ソースファイル ===== -->
  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="Source\AttackParts\ChaseTarget.cpp" />
    <ClCompile Include="Source\AttackParts\SpinAttack.cpp" />
    <ClCompile Include="Source\Scripts\CharacterKeyboardMover.cpp" />
    <ClCompile Include="Source\Scripts\ClipCycler.cpp" />
    <ClCompile Include="Source\Scripts\HitboxCycler.cpp" />
    <ClCompile Include="Source\Scripts\HitTestPlayer.cpp" />
    <ClCompile Include="Source\Scripts\ListFieldSample.cpp" />
    <ClCompile Include="Source\Scripts\WorldFollowSamples.cpp" />
    <ClCompile Include="Source\Scripts\TestBullet.cpp" />
    <ClCompile Include="Source\Scripts\CursorTrailSamples.cpp" />
    <ClCompile Include="Source\Scripts\BurstEffectSamples.cpp" />
    <ClCompile Include="Source\Scripts\TriggerCameraSamples.cpp" />
    <ClCompile Include="Source\Scripts\OrbitCameraSamples.cpp" />
    <ClCompile Include="Source\Scripts\Player\PlayerController.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Source\Scripts\CharacterKeyboardMover.h" />
    <ClInclude Include="Source\Scripts\ClipCycler.h" />
    <ClInclude Include="Source\Scripts\HitboxCycler.h" />
    <ClInclude Include="Source\Scripts\HitTestPlayer.h" />
    <ClInclude Include="Source\Scripts\ListFieldSample.h" />
    <ClInclude Include="Source\Scripts\WorldFollowSamples.h" />
    <ClInclude Include="Source\Scripts\TestBullet.h" />
    <ClInclude Include="Source\Scripts\CursorTrailSamples.h" />
    <ClInclude Include="Source\Scripts\BurstEffectSamples.h" />
    <ClInclude Include="Source\Scripts\TriggerCameraSamples.h" />
    <ClInclude Include="Source\Scripts\OrbitCameraSamples.h" />
    <ClInclude Include="Source\Scripts\Player\PlayerController.h" />
  </ItemGroup>

  <!-- ===== プロジェクトの情報 ===== -->
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{fceff50c-6fda-43ab-89da-b5e1efce7dc8}</ProjectGuid>
    <RootNamespace>Sandbox</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- ===== exe の種類（Microsoft.Cpp.props より前に決める） ===== -->
  <!-- 全部の構成で共通 -->
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <!-- Debug だけデバッグ用のランタイム -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <!-- Release だけ全体の最適化（エンジンの Release も /GL なので、リンクで /LTCG になる） -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- ===== プロパティシート ===== -->
  <ImportGroup Label="PropertySheets">
    <!-- エンジンの場所・include・ライブラリ・参照（同じリポジトリの中なので、1つ上のフォルダ） -->
    <Import Project="..\HTTEngine.props" />
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />

  <!-- ===== 全部の構成で共通 ===== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- Sandbox のフォルダ：Script の .h を "Source/Scripts/～.h" で読めるように -->
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
    <!-- ビルドの後：シェーダーのコンパイラ（dxcompiler.dll・dxil.dll）を exe の隣へ -->
    <!-- エンジンの .shader と Resources を起動するフォルダ（このフォルダ）の HTTEngine\ へ写すのは、HTTEngine.props の CopyHTTEngineRuntimeFiles（ゲームと同じ） -->
    <PostBuildEvent>
      <Command>
copy /Y "$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxcompiler.dll" "$(TargetDir)dxcompiler.dll"
copy /Y "$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxil.dll" "$(TargetDir)dxil.dll"
      </Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <!-- ===== Debug ===== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ===== Development（エディタあり・最適化なし。Script をブレークポイントで止めやすい） ===== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Development'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ===== Release ===== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
